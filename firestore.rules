rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Helper Functions (Phase 3)
    // ===============================================================
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      // Allow if either signed in with email or anonymous (for public forms)
      return isSignedIn();
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isHardcodedAdmin() {
      return isSignedIn() && (
        request.auth.token.email == "info.digitalmount@gmail.com" ||
        request.auth.token.email == "mezabiullakhan@gmail.com" ||
        request.auth.token.email == "zabiullakhanofficial@gmail.com" ||
        request.auth.token.email == "admin@auction.com"
      );
    }

    function isSuperAdmin() {
      return isHardcodedAdmin() || (
        isSignedIn() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "SUPER_ADMIN"
      );
    }

    function isAdmin(auctionId) {
      return isSignedIn() && (
        isSuperAdmin() || 
        (exists(/databases/$(database)/documents/auctions/$(auctionId)) && 
         get(/databases/$(database)/documents/auctions/$(auctionId)).data.createdBy == request.auth.uid) ||
        (exists(/databases/$(database)/documents/auctions/$(auctionId)/staff/$(request.auth.uid)))
      );
    }

    function isValidString(val, minSize, maxSize) {
      return val is string && val.size() >= minSize && val.size() <= maxSize;
    }

    // ===============================================================
    // ENTITY VALIDATORS
    // ===============================================================
    function isValidRegistration(data) {
      return isValidString(data.fullName, 1, 200) &&
             (data.mobile is string) &&
             data.submittedAt is number;
    }

    // ===============================================================
    // RULES
    // ===============================================================

    // Global Catch-all (Phase 0)
    match /{document=**} {
      allow read, write: if false;
    }

    // Public Collections
    match /appConfig/{configId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isSuperAdmin());
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isSignedIn() && (request.auth.uid == userId || isSuperAdmin());
    }

    match /auctions/{auctionId} {
      // Auction is Public for browsing and registration
      allow read: if true;
      allow create: if isSignedIn();
      allow update: if isAdmin(auctionId);
      allow delete: if isSuperAdmin();

      // Sub-collections
      match /players/{playerId} {
        allow read: if true;
        allow write: if isAdmin(auctionId);
      }

      match /teams/{teamId} {
        allow read: if true;
        allow write: if isAdmin(auctionId);
      }

      match /categories/{categoryId} {
        allow read: if true;
        allow write: if isAdmin(auctionId);
      }

      match /roles/{roleId} {
        allow read: if true;
        allow write: if isAdmin(auctionId);
      }

      match /registrations/{regId} {
        // Auction registrations are public for the progress bar and headcount
        allow read: if true;
        allow create: if isValidRegistration(incoming());
        allow update, delete: if isAdmin(auctionId);
      }

      match /captainCodes/{codeId} {
        allow read: if true;
        allow create: if isAdmin(auctionId);
        allow update: if isAdmin(auctionId) || (
          // Allow public to update usage count when registering
          incoming().diff(existing()).affectedKeys().hasOnly(['currentUsage', 'teamCodes', 'teamUsedCount'])
        );
      }

      match /sponsors/{sponsorId} {
        allow read: if true;
        allow write: if isAdmin(auctionId);
      }

      match /auctionLogs/{logId} {
        allow read: if true;
        allow create: if isSignedIn();
        allow write: if isAdmin(auctionId);
      }

      match /arrangementDrafts/{draftId} {
        allow read: if true;
        allow write: if isAdmin(auctionId);
      }

      match /staff/{staffId} {
        allow read: if isAdmin(auctionId);
        allow write: if isAdmin(auctionId);
      }

      match /waitlist/{listId} {
        allow create: if true;
        allow read, list, update: if isAdmin(auctionId);
      }
    }

    // Support System
    match /supportTickets/{ticketId} {
      allow read, write: if isSignedIn() && (resource.data.userId == request.auth.uid || isSuperAdmin());
      match /messages/{msgId} {
        allow read, write: if isSignedIn();
      }
    }
  }
}

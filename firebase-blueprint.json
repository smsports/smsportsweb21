{
  "entities": {
    "Auction": {
      "title": "Auction",
      "description": "Main auction configuration",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "date": { "type": "string" },
        "venue": { "type": "string" },
        "totalTeams": { "type": "number" },
        "logoUrl": { "type": "string" },
        "dateTBD": { "type": "boolean" },
        "slabs": { "type": "array" },
        "status": { "type": "string" },
        "currentPlayerId": { "type": "string" },
        "currentBid": { "type": "number" },
        "highestBidder": { "type": "object" },
        "timer": { "type": "number" },
        "createdAt": { "type": "number" }
      }
    },
    "Team": {
      "title": "Team",
      "description": "Auction teams",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "owner": { "type": "string" },
        "budget": { "type": "number" },
        "logoUrl": { "type": "string" },
        "players": { "type": "array" },
        "teamCode": { "type": "string" }
      }
    },
    "Player": {
      "title": "Player",
      "description": "Player details",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "category": { "type": "string" },
        "role": { "type": "string" },
        "photoUrl": { "type": "string" },
        "basePrice": { "type": "number" },
        "status": { "type": "string" },
        "soldPrice": { "type": "number" },
        "soldTo": { "type": "string" }
      }
    },
    "User": {
      "title": "User",
      "description": "User profiles",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "name": { "type": "string" },
        "role": { "type": "string" },
        "plan": { "type": "object" }
      }
    },
    "Match": {
      "title": "Match",
      "description": "Cricket matches",
      "type": "object",
      "properties": {
        "teamAId": { "type": "string" },
        "teamBId": { "type": "string" },
        "status": { "type": "string" },
        "totalOvers": { "type": "number" },
        "currentInnings": { "type": "number" }
      }
    },
    "RecollectionForm": {
      "title": "Recollection Form",
      "description": "Custom data collection forms",
      "type": "object",
      "properties": {
        "auctionId": { "type": "string" },
        "title": { "type": "string" },
        "note": { "type": "string" },
        "fields": { "type": "array" },
        "isEnabled": { "type": "boolean" },
        "createdAt": { "type": "number" }
      }
    },
    "RecollectionResponse": {
      "title": "Recollection Response",
      "description": "Form submissions",
      "type": "object",
      "properties": {
        "formId": { "type": "string" },
        "responses": { "type": "object" },
        "submittedAt": { "type": "number" }
      }
    }
  },
  "firestore": {
    "/auctions/{auctionId}": {
      "schema": "Auction",
      "description": "Main auction document"
    },
    "/auctions/{auctionId}/teams/{teamId}": {
      "schema": "Team",
      "description": "Teams in this auction"
    },
    "/auctions/{auctionId}/players/{playerId}": {
      "schema": "Player",
      "description": "Players in this auction"
    },
    "/auctions/{auctionId}/arrangementDrafts/{draftId}": {
      "schema": { "type": "object" },
      "description": "Board arrangement snapshots"
    },
    "/auctions/{auctionId}/settings/{settingId}": {
      "schema": { "type": "object" },
      "description": "Auction specific settings"
    },
    "/auctions/{auctionId}/recollectionForms/{formId}": {
      "schema": "RecollectionForm",
      "description": "Data collection forms for this auction"
    },
    "/recollectionResponses/{responseId}": {
      "schema": "RecollectionResponse",
      "description": "Global collection of form responses"
    },
    "/system/{docId}": {
      "schema": { "type": "object", "properties": { "teamIdCounter": { "type": "number" } } },
      "description": "Global system metadata counters"
    },
    "/users/{userId}": {
      "schema": "User",
      "description": "User profiles"
    },
    "/matches/{matchId}": {
      "schema": "Match",
      "description": "Tournament matches"
    },
    "/appConfig/{configId}": {
      "schema": { "type": "object" },
      "description": "Global system configuration"
    },
    "/globalAssets/{assetId}": {
      "schema": { "type": "object" },
      "description": "System-wide brand assets"
    },
    "/systemBroadcasts/{broadcastId}": {
      "schema": { "type": "object" },
      "description": "Global ticker messages"
    },
    "/systemPopups/{popupId}": {
      "schema": { "type": "object" },
      "description": "Global system alerts"
    },
    "/subscriptionPlans/{planId}": {
      "schema": { "type": "object" },
      "description": "Monetization tiers"
    },
    "/promoCodes/{codeId}": {
      "schema": { "type": "object" },
      "description": "System promo codes"
    }
  }
}
